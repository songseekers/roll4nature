# Roll for Veterans - Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# See README for setup instructions

# ─── Site Configuration ─────────────────────────────
NEXT_PUBLIC_SITE_URL=https://songseekers.org

# ─── Mapbox Configuration ───────────────────────────
# Get your token at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ─── Twilio SMS Configuration ───────────────────────
# Get credentials at https://console.twilio.com/
# Forms will work without Twilio — SMS notifications just won't be sent
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1your_twilio_phone_number_here
RECIPIENT_PHONE_NUMBER=+1your_recipient_phone_number_here

# ─── Resend Email Configuration ─────────────────────
# Get your API key at https://resend.com/api-keys
# Forms will work without Resend — email notifications just won't be sent
RESEND_API_KEY=your_resend_api_key_here
RECIPIENT_EMAIL=your_recipient_email_here
